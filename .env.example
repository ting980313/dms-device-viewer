# 複製這個檔案為 .env 後依需要調整（.env 不會被 git 追蹤）

# 目標 DMS 站台（QA 環境）
DMS_BASE_URL=http://13.52.48.194

# DMS 測試帳號（合法帳密，走正常 /login 端點做 headless 登入）
# 這個網頁不提供登入表單輸入帳密，全部帳密只從這裡讀取，不會寫進程式碼或前端。
DMS_EMAIL=your-qa-account@example.com
DMS_PASS=your-password

# 本機服務要監聽的 port
PORT=3000

# express-session 用的加密密鑰，正式使用時請換成隨機字串
SESSION_SECRET=change-me-to-a-random-string
